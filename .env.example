# Image for this site: blank/latest = Sun Peaks, mercerisland = Mercer Island
HUB_IMAGE_TAG=

# Django
DJANGO_SECRET_KEY=any-long-random-string

# Allowed hosts for Django (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database
DB_NAME=sunpeaks_inventory
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# Optional: table-owner login used only for the container's startup migrations.
# When set, DB_USER only needs SELECT/INSERT/UPDATE/DELETE.
DB_MIGRATE_USER=your_db_owner
DB_MIGRATE_PASSWORD=your_db_owner_password

# Django Admin
ADMIN_USER=admin
ADMIN_PASSWORD=your_admin_password

# Spotify API credentials (for Sonos/Spotify integration)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

#########################
#### Wifi App Settings###
#########################
# Read by the bdh-app-wifi app (sites/sunpeaks/apps.txt). It also accepts
# the BDH_WIFI_* names, e.g. BDH_WIFI_NETWORKS_PUBLIC.
# Comma-separated list of WiFi networks requiring auth
WIFI_NETWORKS_AUTH=network1,network2
# Comma-separated list of public WiFi networks
WIFI_NETWORKS_PUBLIC=guest_network

# WiFi passwords (key format: WIFI_PASSWORD_FOR_<NETWORK_NAME_UPPERCASED_SPACES_TO_UNDERSCORES>)
# docker-compose.yml passes through these Sun Peaks network names only.
WIFI_PASSWORD_FOR_BDL=
WIFI_PASSWORD_FOR_BDL_TO_MI=
WIFI_PASSWORD_FOR_BDL_GUEST=

###############################
#### Home Assistant Settings###
###############################
HOMEASSISTANT_URL=http://your-ha-ip:8123/
HOMEASSISTANT_ACCESS_TOKEN=your_ha_long_lived_access_token
# Optional second Home Assistant instance
HOMEASSISTANT_URL_2=
HOMEASSISTANT_ACCESS_TOKEN_2=
# During an owner visit the hub acts as signed in as this (non-staff) user.
# Blank turns automatic sign-in off.
HUB_OWNER_VISIT_USER=

##############################
#### Gemstone Lights     #####
##############################
# Read by the device_control app (also BDH_DEVICE_CONTROL_GEMSTONE_EMAIL / _PASSWORD)
GEMSTONE_EMAIL=your_gemstone_account_email
GEMSTONE_PASSWORD=your_gemstone_account_password
# Napoleon fireplaces (Ayla cloud); blank = no fireplaces
NAPOLEON_EMAIL=
NAPOLEON_PASSWORD=
NAPOLEON_EUROPE=

##############################
#### go2rtc Camera Settings###
##############################
# go2rtc API for server-side calls (host networking, so localhost)
GO2RTC_URL=http://localhost:1984
# URL where browsers reach go2rtc (used in camera page iframes)
GO2RTC_PUBLIC_URL=http://your-hub-ip:1984

# UniFi Protect API (for automatic camera discovery)
# Generate an API key from your UniFi console (Settings > API Keys).
# One numbered block per Protect console (n = 1, 2); NAME labels its cameras.
UNIFI_PROTECT_HOST_1=192.168.10.1
UNIFI_PROTECT_API_KEY_1=your_protect_api_key
UNIFI_PROTECT_NAME_1=Home
UNIFI_PROTECT_HOST_2=
UNIFI_PROTECT_API_KEY_2=
UNIFI_PROTECT_NAME_2=
# Note: RTSP must be enabled on camera channels in UniFi Protect settings
# Optional view-only Protect local user per site (n = 1, 2, ...). Enables the
# cameras app's event history and recording scrubber (admins only).
BDH_CAMERAS_PROTECT_USERNAME_1=
BDH_CAMERAS_PROTECT_PASSWORD_1=
BDH_CAMERAS_PROTECT_USERNAME_2=
BDH_CAMERAS_PROTECT_PASSWORD_2=

##############################
#### Scene Settings###########
##############################
# Read by the device_control app (also BDH_DEVICE_CONTROL_SCENES_FILTER / BDH_SCENES_FILTER)
#SCENE_FILTER=scene1,scene2

##############################
#### BDL Modes (AppDaemon) ###
##############################
# Read by the vacation_mode app (also BDH_VACATION_MODE_MODES_URL / _MODES_API_KEY / _PREHEAT)
# Set to run vacation mode in the bdl_modes AppDaemon app (hub is UI only)
BDL_MODES_URL=http://your-appdaemon-ip:5050/api/appdaemon/bdl_modes
BDL_MODES_API_KEY=shared_secret_from_appdaemon_secrets_yaml
# Show the "Preheat for arrival" scheduler
BDL_MODES_PREHEAT=false

##############################
#### Optional integrations ###
##############################
# Restaurants app: Google Places API (New) key; blank = no fetching
GOOGLE_PLACES_API_KEY=
# Sonos discovery interface (needed with host networking)
SONOS_INTERFACE=
# Sonos night volume limit status (appdaemon-sonos-night)
BDH_SONOS_CONTROL_NIGHT_URL=
# bdl_shuttle AppDaemon app (bus reminders on the dining room Sonos)
BDH_SHUTTLE_REMINDERS_URL=
BDH_SHUTTLE_REMINDERS_API_KEY=
